<div class="page-header">
  <h1 class="section-title" style="margin-bottom: 0;">Categories</h1>
  <%= link_to "New category", new_category_path, class: "btn-primary small" %>
</div>

<% if @categories.any? %>
  <table class="admin-table">
    <thead>
      <tr>
        <th>Name</th>
        <th>Products</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @categories.each do |category| %>
        <tr>
          <td><%= category.name %></td>
          <td><%= category.products.count %></td>
          <td>
            <%= link_to "Edit", edit_category_path(category) %>
            <%= button_to "Delete", category, method: :delete, class: "btn-text", data: { turbo_confirm: "Delete category?" } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <div class="empty-state">
    <p>No categories yet.</p>
  </div>
<% end %>
