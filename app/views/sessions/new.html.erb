<div class="form-card">
  <h1>Log in</h1>
  <%= form_with url: login_path do |f| %>
    <div class="form-group">
      <%= label_tag :email, "Email" %>
      <%= email_field_tag :email, params[:email] %>
    </div>
    <div class="form-group">
      <%= label_tag :password, "Password" %>
      <%= password_field_tag :password %>
    </div>
    <div class="form-actions">
      <%= f.submit "Log in", class: "btn-primary" %>
      <%= link_to "Sign up", signup_path, class: "btn-secondary" %>
    </div>
  <% end %>
</div>
