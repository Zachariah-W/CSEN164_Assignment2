<% content_for :title, @product.name %>

<article class="product-detail">
  <p class="product-meta"><%= @product.category.name %></p>
  <h1><%= @product.name %></h1>
  <% if @product.average_rating %>
    <p class="rating-summary">
      <span class="stars"><%= star_display(@product.average_rating.round) %></span>
      <%= @product.average_rating %> average · <%= @product.review_count %> reviews
    </p>
  <% else %>
    <p class="rating-summary">No reviews yet</p>
  <% end %>
  <p class="price-large"><%= format_price(@product.price) %></p>
  <p class="description"><%= @product.description %></p>

  <%= button_to "Add to Cart", add_to_cart_product_path(@product), method: :post, class: "btn-primary" %>

  <% if logged_in? && current_user.admin? %>
    <div class="form-actions" style="margin-top: 20px;">
      <%= link_to "Edit", edit_product_path(@product), class: "btn-secondary" %>
      <%= button_to "Delete", @product, method: :delete, class: "btn-danger", data: { turbo_confirm: "Delete this product?" } %>
    </div>
  <% end %>
</article>

<section class="reviews-section">
  <h2 class="section-title">Reviews</h2>

  <% if @reviews.any? %>
    <% @reviews.each do |review| %>
      <div class="review-item">
        <div class="review-header">
          <strong><%= review.user.name %></strong>
          <span class="review-stars"><%= star_display(review.rating) %></span>
        </div>
        <p><%= review.comment %></p>
        <% if logged_in? && review.user_id == current_user.id %>
          <div class="form-actions" style="margin-top: 10px;">
            <%= link_to "Edit", edit_review_path(review), class: "btn-secondary" %>
            <%= button_to "Delete", review, method: :delete, class: "btn-danger", data: { turbo_confirm: "Delete your review?" } %>
          </div>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <p class="product-meta">Be the first to leave a review.</p>
  <% end %>

  <% if logged_in? %>
    <% if @user_review %>
      <p class="product-meta" style="margin-top: 20px;">You already reviewed this product.</p>
    <% else %>
      <div class="review-form">
        <h3>Write a review</h3>
        <%= form_with model: @review, url: product_reviews_path(@product) do |f| %>
          <div class="form-group">
            <%= f.label :rating %>
            <%= f.select :rating, (1..5).map { |n| [n, n] } %>
          </div>
          <div class="form-group">
            <%= f.label :comment %>
            <%= f.text_area :comment %>
          </div>
          <%= f.submit "Post review", class: "btn-primary" %>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <p class="product-meta" style="margin-top: 20px;"><%= link_to "Log in", login_path %> to write a review.</p>
  <% end %>
</section>
